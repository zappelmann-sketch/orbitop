# Package source of orbitop (package orbitop-release); updates arrive with the regular system update.
# priority=100 is above the default 99: dnf prefers the smaller number, so packages of Fedora always win.
[orbitop]
name=orbitop
baseurl=https://zappelmann-sketch.github.io/orbitop/rpm/fedora
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-orbitop
priority=100
