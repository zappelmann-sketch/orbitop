#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright © 2026 zappelmann-sketch
# Before the build, build-packages.sh writes debian/changelog from the metainfo into the copy in the container;
# it is never in the repository. orbitop-apt-source has its own source package in packaging/apt-source/.

%:
	dh $@

override_dh_auto_install:
	bash packaging/install-tree.sh debian/orbitop

# Shebangs stay as they are: otherwise dh_python3 turns the root helper's "#!/usr/bin/python3 -I" into
# "#! /usr/bin/python3" without -I. Byte-compiling in postinst and prerm stays (Python Policy 5.3).
override_dh_python3:
	dh_python3 --no-shebang-rewrite
